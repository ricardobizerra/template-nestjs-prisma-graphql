APP_NAME=rblf
PORT=3333

NODE_ENV=
DEVELOPMENT_TYPE=

FRONTEND_URL=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=${APP_NAME}-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

REDIS_PORT=6379
REDIS_HOST=${APP_NAME}-redis
REDIS_PASSWORD=
REDIS_DB=
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
REDIS_TTL=

JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3338/auth/google/callback

# Resend Email (https://resend.com)
RESEND_API_KEY=
MAIL_FROM_EMAIL=onboarding@resend.dev

# Swagger (accessing /api/docs-json in staging/production)
SWAGGER_ACCESS_KEY=

# Storage (optional - choose s3 or r2)
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=         # S3 only
# STORAGE_ENDPOINT=       # R2 only (https://<account_id>.r2.cloudflarestorage.com)