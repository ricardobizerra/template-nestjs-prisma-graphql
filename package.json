  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "db:generate": "drizzle-kit generate --config=src/lib/drizzle/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=src/lib/drizzle/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=src/lib/drizzle/drizzle.config.ts",
    "seed": "tsx src/lib/drizzle/seed.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:cov": "cross-env NODE_ENV=test vitest run --coverage",
    "test:debug": "cross-env NODE_ENV=test vitest --inspect-brk --inspect --logHeapUsage --threads=false",
    "test:e2e": "cross-env NODE_ENV=test vitest run --config ./vitest.config.e2e.ts"
  },
